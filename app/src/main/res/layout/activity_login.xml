<!--                android:inputType="phone"-->
<!--                android:background="@android:color/transparent"-->
<!--                android:textColor="#000000"-->
<!--                android:textSize="16sp" />-->
<!--        </LinearLayout>-->
        <Button
            android:id="@+id/btnSendOTP"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Send OTP"
            android:textColor="#000000"
            android:backgroundTint="#58E2A6"
            android:background="@drawable/rounded_button_green"/>
    </LinearLayout>


    <LinearLayout
        android:id="@+id/otpLayout"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:gravity="center_horizontal"
        android:padding="32dp"
        android:visibility="gone">

        <!-- Title -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Verify Account"
            android:textSize="20sp"
            android:textStyle="bold"
            android:textColor="#000000"
            android:layout_marginBottom="32dp"/>

        <!-- Illustration -->
        <ImageView
            android:layout_width="360dp"
            android:layout_height="360dp"
            android:src="@drawable/ic_illustration_otp"
            android:layout_marginBottom="24dp"/>

        <!-- Subtitle -->
        <TextView
            android:id="@+id/tvMsg"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Enter The Verification Code Sent To\n+91XXXXXXXXXX"
            android:textAlignment="center"
            android:textColor="#000000"
            android:textSize="14sp"
            android:layout_marginBottom="12dp"/>

        <!-- OTP Boxes -->
        <LinearLayout
            android:id="@+id/otpContainer"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:layout_marginBottom="10dp">

            <!-- Create 4 separate input boxes -->
            <EditText
                android:id="@+id/etOTP"
                android:textStyle="bold"
                android:inputType="number"
                android:textSize="16sp"
                android:layout_width="150dp"
                android:textColor="@color/black"
                android:gravity="center"
                android:maxLength="6"

                android:layout_height="wrap_content"/>

            <!--            <EditText-->
            <!--                style="@style/OtpBoxStyle"-->
            <!--                android:id="@+id/etOTP2"/>-->

            <!--            <EditText-->
            <!--                style="@style/OtpBoxStyle"-->
            <!--                android:id="@+id/etOTP3"/>-->

            <!--            <EditText-->
            <!--                style="@style/OtpBoxStyle"-->
            <!--                android:id="@+id/etOTP4"/>-->
            <!--            <EditText-->
            <!--                style="@style/OtpBoxStyle"-->
            <!--                android:id="@+id/etOTP5"/>-->
            <!--            <EditText-->
            <!--            style="@style/OtpBoxStyle"-->
            <!--            android:id="@+id/etOTP6"/>-->

        </LinearLayout>

        <!-- Resend & Verify -->
        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="horizontal">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Didn't Receive the Code? "
                android:textColor="#1B5E20"
                android:textSize="14sp"
                android:layout_marginBottom="24dp"/>
            <TextView
                android:id="@+id/resendOTP"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text=" Resend"
                android:onClick="resendOTP"
                android:textStyle="bold"
                android:textColor="@android:color/holo_blue_dark"
                android:textSize="14sp"

                android:layout_marginBottom="24dp"/>
        </LinearLayout>

        <Button
            android:id="@+id/btnVerifyOTP"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Verify"
            android:textStyle="bold"
            android:textColor="#000000"
            android:backgroundTint="#58E2A6"
            android:background="@drawable/rounded_button_green"/>
    </LinearLayout>
</LinearLayout>
