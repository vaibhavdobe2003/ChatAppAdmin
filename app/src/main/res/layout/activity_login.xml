<!--                android:text="+91"-->
<!--                android:textColor="#000000"-->
<!--                android:textSize="16sp"-->
<!--                android:layout_gravity="center_vertical"-->
<!--                android:layout_marginEnd="8dp" />-->

<!--            <EditText-->
<!--                android:id="@+id/etPhoneNumber"-->
<!--                android:layout_width="0dp"-->
